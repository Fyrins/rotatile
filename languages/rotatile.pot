#. Plugin Name of the plugin
#: rotatile.php
msgid "Rotatile"
msgstr ""

#. Plugin URI of the plugin
#: rotatile.php
msgid "https://github.com/Fyrins/rotatile"
msgstr ""

#. Description of the plugin
#: rotatile.php
msgid "Adds a Rotation panel to the WordPress block inspector so a supported block can be tilted by a free angle. The angle is turned into a CSS transform when the page is built, so the front end ships no JavaScript."
msgstr ""

#. Author of the plugin
#: rotatile.php
msgid "Alexandre Revire"
msgstr ""

#. Author URI of the plugin
#: rotatile.php
msgid "https://alexandre-revire.fr"
msgstr ""

#. translators: Title of the block inspector panel that tilts a block.
#: src/editor.js:104
msgctxt "block inspector panel title"
msgid "Rotation"
msgstr ""

#: src/editor.js:113
msgid "Angle"
msgstr ""

#. translators: 1: Lowest angle offered, in degrees. 2: Highest angle offered, in degrees.
#: src/editor.js:120
msgid "Between %1$d° and %2$d°. A rotated block keeps its original space on the page, so its corners overlap neighbouring content, and a full-width block at a large angle can push the page sideways. Rotating text also makes that text harder to read."
msgstr ""

#. translators: Button that sets the rotation angle back to zero.
#: src/editor.js:137
msgctxt "button label"
msgid "Reset"
msgstr ""
